CREATE TABLE PI.DJ_CHATBOT
(
    RUN_DATE            DATE NOT NULL,
    TRANSACTION_DATE    TIMESTAMP,
    INPUT_FILENAME      VARCHAR2(200),
    MSISDN              VARCHAR2(20),
    CORRELATION_ID      VARCHAR2(50),
    ID                  VARCHAR2(50),
    INTERFACE_STATUS    VARCHAR2(20),
    ACTION_NAME         VARCHAR2(100)
)
TABLESPACE PI_TBS
PARTITION BY RANGE (RUN_DATE)
INTERVAL (NUMTODSINTERVAL(1,'DAY'))
(
    PARTITION P_INIT
    VALUES LESS THAN (DATE '2026-01-01')
);


CREATE INDEX PI.IDX_DJ_CHATBOT_01
ON PI.DJ_CHATBOT (RUN_DATE, MSISDN)
LOCAL
TABLESPACE PI_TBS;


OPTIONS (SKIP=1)

LOAD DATA
INFILE '__INPUT_FILE__'
APPEND
INTO TABLE PI.DJ_CHATBOT
FIELDS TERMINATED BY ','
OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
    RUN_DATE            DATE "YYYY-MM-DD",
    TRANSACTION_DATE    TIMESTAMP "YYYY-MM-DD HH24:MI:SS",
    INPUT_FILENAME,
    MSISDN,
    CORRELATION_ID,
    ID,
    INTERFACE_STATUS,
    ACTION_NAME
)
